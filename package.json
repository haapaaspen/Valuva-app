{
	"name": "valuva-ai-graphics-suite",
	"version": "1.0.0",
	"private": true,
	"description": "HTML-based graphics generator for DaVinci Resolve with Electron shell",
	"workspaces": [
		"electron",
		"resolve-plugin"
	],
	"scripts": {
		"dev:plugin": "npm run dev --workspace=resolve-plugin",
		"build:plugin": "npm run build --workspace=resolve-plugin",
		"preview:plugin": "npm run preview --workspace=resolve-plugin",
		"check:plugin": "npm run check --workspace=resolve-plugin",
		"test:plugin": "npm run test --workspace=resolve-plugin",
		"start:electron": "npm start --workspace=electron"
	},
	"dependencies": {
		"pixi.js": "^8.9.2",
		"svelte-pixi": "^7.0.0"
	}
}
